NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only:
SUPABASE_SERVICE_ROLE_KEY=
# Groq powers natural-language goal entry. Without a key the app falls back to a
# keyword parser. Get a free key at console.groq.com.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_API_KEY=
# Web Push (VAPID). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# Public key is exposed to the browser; private key is server-only.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Contact URI sent with each push (mailto: or https:).
VAPID_SUBJECT=mailto:you@example.com
# ── Reminder processor (Slice 2) ──────────────────────────────
# Shared secret the processor route requires in `Authorization: Bearer <token>`.
CRON_INVOKE_TOKEN=
# DEV ONLY: same value, exposed to the "Run due reminders now" button in Settings.
# Do not set this in production — the real cron passes the token server-side.
NEXT_PUBLIC_CRON_INVOKE_TOKEN=
# ── Virtual Therapist (local AI services) ─────────────────────
# All local & offline. Start scripts: ~/whisper-stt, ~/kokoro-tts; Ollama runs as a service.
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
WHISPER_URL=http://127.0.0.1:9000
KOKORO_URL=http://127.0.0.1:8880
